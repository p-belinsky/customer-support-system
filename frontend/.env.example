# Reference list of every env var the frontend build reads (see src/api/axios.js).
# Vite only picks these up for `import.meta.env.*` if they're prefixed with VITE_.
# Not needed for local dev (falls back to the Vite proxy's relative /api path) —
# only required for the deployed Static Site build, where the backend is a separate origin.

VITE_API_BASE_URL=https://customer-support-backend.onrender.com/api
