# Reference list of every env var backend/src/main/resources/application.properties reads.
# Spring Boot does NOT load this file automatically — it's documentation only, for setting
# values in the Render dashboard (or render.yaml). For local dev, real secret values go in
# application-secrets.properties instead (gitignored, auto-imported by application.properties).

# --- Server ---
# Render sets this automatically; no need to set it yourself.
PORT=8080

# --- Database (Render: use the "fromDatabase" values wired in render.yaml) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=support_system
DB_USERNAME=postgres
DB_PASSWORD=password

# --- JPA ---
# Keep false in production to avoid leaking query data (incl. PII) into logs.
JPA_SHOW_SQL=false

# --- Admin login ---
ADMIN_USERNAME=admin
# Bcrypt hash, e.g. {bcrypt}$2a$10$...  Generate with Spring Security's BCryptPasswordEncoder.
ADMIN_PASSWORD_HASH=

# --- SendGrid ---
SENDGRID_API_KEY=
SENDGRID_FROM_ADDRESS=support@philbelinsky.com
SENDGRID_INBOUND_REPLY_DOMAIN=inbound.philbelinsky.com
SENDGRID_WEBHOOK_SECRET=

# --- AI (Google GenAI via Spring AI) ---
GOOGLE_GENAI_API_KEY=
GOOGLE_GENAI_CHAT_MODEL=gemini-3.5-flash-lite

# --- Cross-origin session cookie ---
# Local dev (same-origin via Vite proxy): Lax / false.
# Render (frontend is a separate origin): None / true.
COOKIE_SAME_SITE=Lax
COOKIE_SECURE=false

# --- CORS ---
# Comma-separated list of origins allowed to call the API with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:5173
